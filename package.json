{
  "name": "mymem",
  "version": "2026.5.4",
  "description": "OpenClaw enhanced LanceDB memory plugin with hybrid retrieval (Vector + BM25), cross-encoder rerank, multi-scope isolation, long-context chunking, and management CLI",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "cli.ts",
    "src",
    "scripts",
    "benchmark",
    "openclaw.plugin.json",
    "README.md",
    "TECHNICAL_DOC.md"
  ],
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "memory",
    "lancedb",
    "vector-search",
    "bm25",
    "hybrid-retrieval",
    "rerank",
    "ai-memory",
    "long-term-memory",
    "chunking",
    "long-context"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Xinslive/MyMem.git"
  },
  "author": "win4r",
  "license": "MIT",
  "scripts": {
    "test": "npm run test:smoke",
    "test:smoke": "node --test test/config-utils.test.mjs test/capture-detection.test.mjs test/runtime-write-policy.test.mjs test/scope-null-isolation.test.mjs test/admission-rejection-audit-redaction.test.mjs test/write-redaction-smoke.test.mjs && node test/plugin-manifest-regression.mjs && node test/cli-smoke.mjs",
    "version": "node scripts/sync-plugin-version.mjs openclaw.plugin.json package.json && git add openclaw.plugin.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src/ index.ts cli.ts",
    "lint:fix": "eslint src/ index.ts cli.ts --fix",
    "lint:audit": "npm audit --omit=dev --audit-level=high || echo 'Audit found issues — review above'",
    "benchmark": "node --import jiti/register benchmark/run.ts --scenario all",
    "benchmark:ci": "node --import jiti/register benchmark/run.ts --scenario all --rows 80 --iterations 5"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.27.2",
    "@sinclair/typebox": "0.34.48",
    "apache-arrow": "18.1.0",
    "json5": "^2.2.3",
    "openai": "^6.21.0",
    "proper-lockfile": "^4.1.2",
    "stream-json": "^1.9.1",
    "undici": "^6.27.0"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  },
  "optionalDependencies": {
    "@lancedb/lancedb-darwin-arm64": "^0.27.2",
    "@lancedb/lancedb-linux-arm64-gnu": "^0.27.2",
    "@lancedb/lancedb-linux-arm64-musl": "^0.27.2",
    "@lancedb/lancedb-linux-x64-gnu": "^0.27.2",
    "@lancedb/lancedb-linux-x64-musl": "^0.27.2",
    "@lancedb/lancedb-win32-x64-msvc": "^0.27.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "commander": "^14.0.0",
    "eslint": "^10.2.1",
    "jiti": "^2.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1"
  }
}
